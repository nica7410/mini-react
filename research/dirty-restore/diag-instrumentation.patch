index 0000000..187e998
--- /dev/null
+++ b/src/core/diagProbe.ts
@@ -0,0 +1,16 @@
+// Research-only probe (dirty-restore diagnostics). Not part of any timing build.
+// Phase boundaries only: no per-node clock reads. Counters are plain integer adds.
+interface Probe { enabled: boolean; t: Record<string, number>; n: Record<string, number> }
+const state = () => (globalThis as unknown as { __drDiag?: Probe }).__drDiag;
+export const diagNow = (): number => state()?.enabled ? performance.now() : 0;
+export function diagTime(name: string, start: number): number {
+  const probe = state(); if (!probe?.enabled) return 0;
+  const end = performance.now(); probe.t[name] = (probe.t[name] ?? 0) + end - start; return end;
+}
+export function diagCount(name: string, value = 1): void {
+  const probe = state(); if (probe?.enabled) probe.n[name] = (probe.n[name] ?? 0) + value;
+}
+export function diagRegister(name: string, value: unknown): void {
+  const api = ((globalThis as unknown as { __drDiagApi?: Record<string, unknown> }).__drDiagApi ??= {});
+  api[name] = value;
+}
